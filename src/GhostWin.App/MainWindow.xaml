<ui:FluentWindow x:Class="GhostWin.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:GhostWin.App.ViewModels"
                 xmlns:controls="clr-namespace:GhostWin.App.Controls"
                 xmlns:conv="clr-namespace:GhostWin.App.Converters"
                 Title="{Binding WindowTitle}"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <!--
        M-16-B Day 1 (FR-01) + P0v2 (2026-04-29): root = ui:FluentWindow
        without inline WindowChrome.

        WindowChrome must NOT be set in XAML when ExtendsContentIntoTitleBar=
        True. wpfui FluentWindow internally calls WindowChrome.SetWindowChrome
        with CaptionHeight=0 inside OnSourceInitialized -> OnExtendsContent-
        IntoTitleBarChanged (verified against lepoco/wpfui commit 38e888a751
        which is the source of the 3.1.1 NuGet package), so any XAML-side
        WindowChrome is overwritten after the HWND is created. We restore
        a CaptionHeight=32 WindowChrome in MainWindow.xaml.cs.OnSourceInitialized
        AFTER calling base — that runs after wpfui's overwrite and survives.

        Background is intentionally not set so the wpfui RemoveBackground
        path can switch the visual root to Brushes.Transparent at the
        SetCurrentValue precedence level. With Background bound to a
        DynamicResource (a local value), SetCurrentValue would lose the
        precedence battle and Mica would be blocked.
    -->

    <Window.Resources>
        <conv:ActiveIndicatorBrushConverter x:Key="ActiveIndicatorBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Color tokens are now centralised in Themes/Colors.Dark.xaml and
             Colors.Light.xaml (registered via App.xaml MergedDictionaries).
             SidebarHover and SidebarSelected window-scope keys were unused
             dead code (only re-set by ApplyThemeColors but never bound to
             any element); they are intentionally not migrated. -->

        <!--
            M-16-B FR-04/05 (Day 4): GridSplitter style — outer 8px transparent
            (mouse hit area) + inner 1px hairline (visual). Reuses M-A
            Divider.Brush token. Focusable=False to keep E2E AutomationId
            hosts unaffected.
        -->
        <Style x:Key="GhostWin.GridSplitter"
                TargetType="GridSplitter">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Width"
                    Value="2"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>
            <Setter Property="ResizeBehavior"
                    Value="PreviousAndNext"/>
            <Setter Property="ResizeDirection"
                    Value="Columns"/>
            <Setter Property="Cursor"
                    Value="SizeWE"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle Width="1"
                                       Fill="{DynamicResource Divider.Brush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Stretch"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption button style (VS Code / cmux pattern) -->
        <Style x:Key="CaptionButtonStyle"
                TargetType="Button">
            <Setter Property="Width"
                    Value="46"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Button.Hover.Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
                TargetType="Button">
            <Setter Property="Width"
                    Value="46"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Accent.CloseHover.Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar tab item style (cmux hover + selection) -->
        <Style x:Key="SidebarItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Margin"
                    Value="{StaticResource Spacing.SidebarItem.Margin}"/>
            <Setter Property="Padding"
                    Value="{StaticResource Spacing.SidebarItem.Padding}"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="AutomationProperties.AutomationId"
                    Value="{Binding WorkspaceId, StringFormat='E2E_WorkspaceItem_{0}'}"/>
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding WorkspaceId, StringFormat='workspaceId={0}'}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource Sidebar.Hover.Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource Sidebar.Selected.Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- New Tab button style -->
        <!-- M-16-B FR-17 (Day 6): Sidebar + button bumped to Fitts standard 32x32 -->
        <Style x:Key="NewTabButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Text.Secondary.Brush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="MinWidth"
                    Value="32"/>
            <Setter Property="MinHeight"
                    Value="32"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Sidebar.Hover.Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Workspace shortcuts (sidebar entries — cmux model) -->
        <KeyBinding Gesture="Ctrl+T"
                Command="{Binding NewWorkspaceCommand}"/>
        <KeyBinding Gesture="Ctrl+W"
                    Command="{Binding CloseWorkspaceCommand}"
                    CommandParameter="{Binding SelectedWorkspace}"/>
        <KeyBinding Gesture="Ctrl+Tab"
                Command="{Binding NextWorkspaceCommand}"/>
        <!-- Pane shortcuts (within active workspace) -->
        <KeyBinding Gesture="Alt+V"
                Command="{Binding SplitVerticalCommand}"/>
        <KeyBinding Gesture="Alt+H"
                Command="{Binding SplitHorizontalCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+W"
                Command="{Binding ClosePaneCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Custom TitleBar (cmux style) ═══ -->
        <Grid Grid.Row="0"
                Background="{DynamicResource Window.TitleBar.Background.Brush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                    Text="{Binding WindowTitle}"
                       VerticalAlignment="Center"
                    Margin="{StaticResource Spacing.WindowTitle.Margin}"
                       FontSize="12"
                    Foreground="{DynamicResource Text.Secondary.Brush}"
                       FontFamily="Segoe UI Variable"/>

            <StackPanel Grid.Column="2"
                    Orientation="Horizontal">
                <!-- E2E automation hooks — zero-size buttons bound to the
                     same RelayCommands as the KeyBindings above. UI
                     Automation (UIA) consumers like FlaUI can locate
                     these by AutomationId and call InvokePattern.Invoke,
                     bypassing User32.SendInput entirely. This is the
                     only way to drive the app from a disconnected
                     Windows session where SendInput fails with
                     ERROR_ACCESS_DENIED (split-content-loss-v2 cycle,
                     2026-04-09). The buttons are keyboard-unfocusable
                     and occupy zero visual space. -->
                <Button Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_SplitVertical"
                        AutomationProperties.Name="E2E SplitVertical"
                        Command="{Binding SplitVerticalCommand}"/>
                <Button Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_SplitHorizontal"
                        AutomationProperties.Name="E2E SplitHorizontal"
                        Command="{Binding SplitHorizontalCommand}"/>
                <Button Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_ClosePane"
                        AutomationProperties.Name="E2E ClosePane"
                        Command="{Binding ClosePaneCommand}"/>
                <Button Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_NewWorkspace"
                        AutomationProperties.Name="E2E NewWorkspace"
                        Command="{Binding NewWorkspaceCommand}"/>
                <Button Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_OpenCommandPalette"
                        AutomationProperties.Name="E2E OpenCommandPalette"
                        Click="OnOpenCommandPaletteAutomation"/>
                <Button x:Name="MouseCursorShapeProbe"
                        Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_MouseCursorShape"/>
                <Button x:Name="MouseCursorIdProbe"
                        Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_MouseCursorId"/>
                <Button x:Name="MouseCursorSessionProbe"
                        Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_MouseCursorSession"/>
                <Button x:Name="MouseCursorVersionProbe"
                        Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_MouseCursorVersion"/>
                <Button x:Name="MouseCursorUpdatedAtProbe"
                        Width="0"
                        Height="0"
                        Focusable="False"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="E2E_MouseCursorUpdatedAt"/>
                <!-- FR-06 (M-16-F): caption buttons stay Focusable=False per Windows
                     convention (cmux / Windows Terminal / VS Code parity). Tab cycle
                     stays in chrome ring (Sidebar / NotifPanel) and content; caption
                     is reachable via mouse only. Audit 2026-05-08 verified 13 total
                     Focusable=False sites: 10 E2E zero-size hooks (intentional, see
                     §"E2E hidden hooks" comment above) + 3 caption (intentional).
                     User-blocking count = 0. -->
                <Button Style="{StaticResource CaptionButtonStyle}"
                        Click="OnMinimize"
                        Focusable="False"
                        IsTabStop="False"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.AutomationId="MinimizeButton"
                        AutomationProperties.Name="Minimize"
                        ToolTip="Minimize">
                    <Path Data="M 0,5 H 10"
                            Stroke="{DynamicResource Text.Secondary.Brush}"
                            StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaxRestoreButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="OnMaxRestore"
                        Focusable="False"
                        IsTabStop="False"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.AutomationId="MaxRestoreButton"
                        AutomationProperties.Name="Maximize"
                        ToolTip="Maximize">
                    <!-- Icon + Name + ToolTip switched by OnWindowStateChanged in code-behind -->
                    <Path x:Name="MaxRestoreIcon"
                          Data="M 0,0 H 10 V 10 H 0 Z"
                          Stroke="{DynamicResource Text.Secondary.Brush}"
                            StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}"
                        Click="OnClose"
                        Focusable="False"
                        IsTabStop="False"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.AutomationId="CloseButton"
                        AutomationProperties.Name="Close window"
                        ToolTip="Close window">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                            Stroke="{DynamicResource Text.Secondary.Brush}"
                            StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Content ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="{Binding SidebarWidth, Mode=OneWay}"
                                  MinWidth="120"
                        MaxWidth="400"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="NotificationPanelColumn"
                                  Width="{Binding NotificationPanelWidth, Mode=OneWay}"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar (cmux workspace sidebar) ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Sidebar.Background.Brush}">
                <DockPanel>
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top"
                            Margin="{StaticResource Spacing.SidebarHeader.Margin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- M-16-B FR-19 (Day 6): use M-A Text.Tertiary.Brush token instead of Opacity 0.4 -->
                        <TextBlock Text="GHOSTWIN"
                                FontSize="11"
                                FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Tertiary.Brush}"
                                   FontFamily="Segoe UI Variable"/>
                        <!-- M-16-B FR-A1 (Day 7): TabIndex + AutomationProperties.Name
                             so keyboard users reach the new-workspace button.
                             P3 (2026-04-29): x:Name added so OnLoaded can
                             explicitly Keyboard.Focus this control as the
                             initial Tab anchor. -->
                        <Button x:Name="SidebarNewWorkspaceButton"
                                Grid.Column="1"
                                Content="＋"
                                FontSize="14"
                                Style="{StaticResource NewTabButtonStyle}"
                                Command="{Binding NewWorkspaceCommand}"
                                ToolTip="New Workspace (Ctrl+T)"
                                Width="32"
                                Height="32"
                                Padding="0"
                                TabIndex="100"
                                AutomationProperties.Name="New workspace"/>
                    </Grid>

                    <!-- Settings gear icon (Bottom-docked before ListBox so it stays at bottom) -->
                    <!-- M-16-B FR-A1 (Day 7): Settings gear is a primary entry point — make
                         it focusable + screen-reader announceable. Focusable was previously
                         False to keep terminal focus, but Tab order on the chrome layer is
                         independent and Esc still returns focus via OnTerminalKeyDown. -->
                    <Button DockPanel.Dock="Bottom"
                            Content="⚙"
                            FontSize="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Text.Tertiary.Brush}"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Margin="{StaticResource Spacing.SidebarBottomButton.Margin}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings (Ctrl+,)"
                            TabIndex="101"
                            AutomationProperties.Name="Open settings"/>

                    <!-- Workspace list (cmux sidebar) -->
                    <!-- M-16-B FR-14 (Day 6): explicit ScrollViewer policy so a
                         large workspace count does not push the gear icon out
                         of view; vertical scrollbar appears only when needed.
                         M-16-B FR-A1 (Day 7): TabIndex + AutomationProperties.Name
                         so screen readers announce the workspace list as a region. -->
                    <ListBox x:Name="SidebarListBox"
                             DockPanel.Dock="Top"
                             ItemsSource="{Binding Workspaces}"
                             SelectedItem="{Binding SelectedWorkspace}"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TabIndex="102"
                             AutomationProperties.Name="Workspaces"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnSidebarPreviewMouseLeftButtonDown"
                             PreviewMouseMove="OnSidebarPreviewMouseMove"
                             DragOver="OnSidebarDragOver"
                             DragLeave="OnSidebarDragLeave"
                             Drop="OnSidebarDrop"
                             Margin="{StaticResource Spacing.WorkspacesList.Margin}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkspaceItemViewModel}">
                                <Grid>
                                    <Grid.ContextMenu>
                                        <!-- M-16-D FR-02: 7-item sidebar context menu -->
                                        <ContextMenu>
                                             <MenuItem Header="Rename"
                                                       Command="{Binding StartRenameCommand}"
                                                       AutomationProperties.AutomationId="E2E_Context_Workspace_Rename"
                                                       AutomationProperties.Name="Rename workspace"/>
                                             <MenuItem Header="Edit description"
                                                       IsEnabled="False"
                                                       AutomationProperties.AutomationId="E2E_Context_Workspace_EditDescription"
                                                       AutomationProperties.Name="Edit workspace description"/>
                                             <MenuItem Header="Pin workspace"
                                                       IsEnabled="False"
                                                       AutomationProperties.AutomationId="E2E_Context_Workspace_Pin"
                                                       AutomationProperties.Name="Pin workspace"/>
                                            <Separator/>
                                             <MenuItem Header="Move up"
                                                       Command="{Binding MoveUpCommand}"
                                                       AutomationProperties.AutomationId="E2E_Context_Workspace_MoveUp"
                                                       AutomationProperties.Name="Move workspace up"/>
                                             <MenuItem Header="Move down"
                                                       Command="{Binding MoveDownCommand}"
                                                       AutomationProperties.AutomationId="E2E_Context_Workspace_MoveDown"
                                                       AutomationProperties.Name="Move workspace down"/>
                                            <Separator/>
                                             <MenuItem Header="Mark all as read"
                                                       IsEnabled="False"
                                                       AutomationProperties.AutomationId="E2E_Context_Workspace_MarkAllRead"
                                                       AutomationProperties.Name="Mark all notifications read"/>
                                            <Separator/>
                                             <MenuItem Header="Close workspace"
                                                       Command="{Binding CloseWorkspaceCommand}"
                                                       AutomationProperties.AutomationId="E2E_Context_Workspace_Close"
                                                       AutomationProperties.Name="Close workspace"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Active indicator (cmux leftRail, 3px, accent) -->
                                    <!-- M-16-B FR-20 (Day 6): negative Margin replaced with Padding-style positioning -->
                                    <Border Grid.Column="0"
                                            Width="3"
                                            CornerRadius="1.5"
                                            Margin="{StaticResource Spacing.WorkspaceItem.Indicator.Margin}"
                                            HorizontalAlignment="Left"
                                            Background="{Binding IsActive,
                                                Converter={StaticResource ActiveIndicatorBrush}}"/>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- M-16-D D-03: inline rename TextBox vs Title TextBlock -->
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                    FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary.Brush}"
                                                       FontFamily="Segoe UI Variable"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsRenaming,
                                                           Converter={StaticResource InverseBoolToVis}}"/>
                                            <TextBox Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13"
                                                    FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Text.Primary.Brush}"
                                                     Background="{DynamicResource ListItem.Hover.Brush}"
                                                     BorderBrush="{DynamicResource Accent.Primary.Brush}"
                                                     BorderThickness="1"
                                                     Padding="{StaticResource Spacing.WorkspaceItem.Title.Padding}"
                                                     FontFamily="Segoe UI Variable"
                                                     Visibility="{Binding IsRenaming,
                                                         Converter={StaticResource BoolToVisibility}}"
                                                     KeyDown="OnSidebarRenameKeyDown"
                                                     LostFocus="OnSidebarRenameLostFocus"
                                                     Loaded="OnSidebarRenameLoaded"
                                                     AutomationProperties.AutomationId="E2E_RenameTextBox"/>
                                            <Ellipse Width="8"
                                                    Height="8"
                                                     Fill="{DynamicResource Notification.UnreadCount.Brush}"
                                                     Margin="{StaticResource Spacing.WorkspaceItem.Ring.Margin}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding NeedsAttention,
                                                         Converter={StaticResource BoolToVisibility}}"
                                                     ToolTip="{Binding LastOscMessage}"
                                                     AutomationProperties.AutomationId="{Binding WorkspaceId,
                                                         StringFormat=E2E_NotificationRing_{0}}"/>
                                            <!-- Phase 6-B: Agent status badge -->
                                            <TextBlock Text="{Binding AgentStateBadge}"
                                                       FontSize="10"
                                                    Margin="{StaticResource Spacing.WorkspaceItem.Status.Margin}"
                                                       Foreground="{Binding AgentStateColor}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable"
                                                       Visibility="{Binding ShowAgentBadge,
                                                           Converter={StaticResource BoolToVisibility}}"
                                                       AutomationProperties.AutomationId="{Binding WorkspaceId,
                                                           StringFormat=E2E_AgentBadge_{0}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Cwd}"
                                                   FontSize="11"
                                                Margin="{StaticResource Spacing.WorkspaceItem.Cwd.Margin}"
                                                   Foreground="{DynamicResource Text.Tertiary.Brush}"
                                                   FontFamily="Segoe UI Variable"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DataContext.ShowCwd,
                                                       RelativeSource={RelativeSource AncestorType=ListBox},
                                                       Converter={StaticResource BoolToVisibility}}"/>
                                        <!-- Phase 6-C: git branch + PR info -->
                                        <TextBlock FontSize="10"
                                                Margin="{StaticResource Spacing.WorkspaceItem.Git.Margin}"
                                                   Foreground="{DynamicResource Text.Tertiary.Brush}"
                                                   FontFamily="Segoe UI Variable"
                                                   Visibility="{Binding HasGitBranch,
                                                       Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="{Binding GitBranch, Mode=OneWay}"/>
                                            <Run Text="{Binding GitPrInfo, Mode=OneWay}"
                                                 Foreground="{DynamicResource Text.Secondary.Brush}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Close button -->
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            FontSize="9"
                                            Foreground="{DynamicResource Text.Tertiary.Brush}"
                                            Style="{StaticResource NewTabButtonStyle}"
                                            Command="{Binding DataContext.CloseWorkspaceCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Opacity="0.6"
                                            AutomationProperties.AutomationId="WorkspaceCloseButton"
                                            AutomationProperties.Name="{Binding Name, StringFormat={}Close workspace {0}}"
                                            ToolTip="{Binding Name, StringFormat={}Close workspace {0}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Divider (M-16-B FR-04/05 Day 4): GridSplitter outer 8px transparent + inner 1px hairline -->
            <GridSplitter Grid.Column="1"
                    Style="{StaticResource GhostWin.GridSplitter}"
                          DragCompleted="OnSidebarSplitterDragCompleted"/>

            <!-- ═══ Notification Panel (Phase 6-B) ═══ -->
            <controls:NotificationPanelControl Grid.Column="2"
                                               Visibility="{Binding IsNotificationPanelOpen,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- M-16-B FR-04/05 (Day 4): GridSplitter for NotificationPanel — visible only when panel is open -->
            <GridSplitter Grid.Column="3"
                    Style="{StaticResource GhostWin.GridSplitter}"
                          DragCompleted="OnNotificationPanelSplitterDragCompleted"
                          Visibility="{Binding IsNotificationPanelOpen,
                              Converter={StaticResource BoolToVisibility}}"/>

            <!-- ═══ Terminal area (hidden when settings open) ═══ -->
            <Border Grid.Column="4"
                    Background="{DynamicResource Terminal.Background.Brush}"
                    Visibility="{Binding IsSettingsOpen,
                        Converter={StaticResource InverseBoolToVis}}">
                <!--
                    M-16-B P3 (2026-04-29): PaneContainerControl is removed
                    from the Tab navigation chain. It is a HwndHost whose Win32
                    child window swallows WM_KEYDOWN, so once Tab focus lands
                    here it cannot return to the Sidebar buttons via WPF
                    logical-focus routing. The terminal still receives focus
                    on click; advanced users can also add a keybinding to
                    jump back into it (follow-up). cmux / VS Code use the
                    same pattern (Tab navigates chrome only, terminal entry
                    via click or Ctrl+` style hotkey).
                -->
                <controls:PaneContainerControl x:Name="PaneContainer"
                                               IsTabStop="False"
                                               KeyboardNavigation.TabNavigation="None"/>
            </Border>

            <!-- ═══ Settings page (shown when settings open) ═══ -->
            <!--
                M-16-B FR-11 (P3 follow-up 2026-04-29): Settings page opacity
                fade. Visibility binding removed — code-behind controls
                Visibility (Collapsed initially, Visible during fade-in,
                Collapsed at end of fade-out). Opacity is animated from 0 to
                1 (open) or 1 to 0 (close) over 200ms with CubicEase EaseOut.
                Animation logic lives in MainWindow.xaml.cs.AnimateSettingsPage,
                triggered from the existing PropertyChanged handler on
                MainWindowViewModel.IsSettingsOpen.
            -->
            <controls:SettingsPageControl x:Name="SettingsPage"
                                          Grid.Column="4"
                                          DataContext="{Binding SettingsPageVM}"
                                          Visibility="Collapsed"
                                          Opacity="0"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
